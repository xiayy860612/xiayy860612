---
import type { GetStaticPaths, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import SaaQuestionCard from '../../../components/SaaQuestionCard.astro';
import { SITE_TITLE } from '../../../consts';
import { hrefFor } from '../../../lib/saa';

// 一题一页：paginate 的 pageSize 设成 1，第 N 题就是第 N 页，保证 /aws/saa/N 深链接、
// 刷新和无 JS 时都有完整的首屏。页面加载后由 scripts/saa-quiz.ts 接管：取题目清单，
// 切题时只 fetch 对应题目的 JSON 原地更新，不再整页跳转。
export const getStaticPaths = (async ({ paginate }) => {
	const questions = (await getCollection('awsSaa')).sort((a, b) => a.data.index - b.data.index);
	return paginate(questions, { pageSize: 1 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<CollectionEntry<'awsSaa'>> };
const question = page.data[0];
const progress = Math.round((question.data.index / question.data.total) * 100);

const title = 'AWS SAA';
const description = 'AWS Certified Solutions Architect – Associate 题库，点击卡片查看答案';

const prevIndex = question.data.index - 1;
const nextIndex = question.data.index + 1;
const hasPrev = prevIndex >= 1;
const hasNext = nextIndex <= page.lastPage;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`${title} 第 ${question.data.index} 题 | ${SITE_TITLE}`}
			description={description}
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="quiz-head">
				<h1>AWS SAA 题库</h1>
				<p class="intro">
					点击卡片任意位置翻面查看正确答案与解析，也可以用键盘 <kbd>←</kbd> <kbd>→</kbd> 切换题目。
				</p>
			</div>

			<!-- 切题时进度条、卡片、分页器会就地更新；其中只有卡片参与滑入滑出动画。 -->
			<div class="quiz-body">
				<div
					class="quiz-progress"
					role="progressbar"
					data-progress
					aria-valuenow={question.data.index}
					aria-valuemin="1"
					aria-valuemax={question.data.total}
					aria-label={`题目进度：第 ${question.data.index} / ${question.data.total} 题`}
				>
					<div class="quiz-progress-track">
						<div class="quiz-progress-fill" data-progress-fill style={`width: ${progress}%`}></div>
					</div>
					<span class="quiz-progress-label" data-progress-label aria-hidden="true">{progress}%</span>
				</div>

				<div class="quiz-card" data-card>
				<SaaQuestionCard question={question} height="30rem" />
			</div>

			<nav
				class="pager"
				aria-label="题目导航"
				data-pager
				data-current={question.data.index}
				data-total={page.lastPage}
			>
				<a
					class:list={['step', { disabled: !hasPrev }]}
					href={hasPrev ? hrefFor(prevIndex) : undefined}
					rel="prev"
					data-dir="prev"
					aria-disabled={hasPrev ? 'false' : 'true'}
				>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14">
						<path
							fill="currentColor"
							d="M9.78 3.22a.75.75 0 0 1 0 1.06L6.06 8l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0z"
						/>
					</svg>
					<span>上一题</span>
				</a>

				<form class="jump" data-jump data-last={page.lastPage}>
					<label class="sr-only" for="jump-input">
						跳转到题号
					</label>
					<span class="counter">
						第
						<input
							id="jump-input"
							name="index"
							type="number"
							min="1"
							max={page.lastPage}
							value={question.data.index}
							inputmode="numeric"
						/>
						/ <span data-last-label>{page.lastPage}</span> 题
					</span>
					<button type="submit">跳转</button>
				</form>

				<a
					class:list={['step', { disabled: !hasNext }]}
					href={hasNext ? hrefFor(nextIndex) : undefined}
					rel="next"
					data-dir="next"
					aria-disabled={hasNext ? 'false' : 'true'}
				>
					<span>下一题</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14">
						<path
							fill="currentColor"
							d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 1 1-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 0 1 0-1.06z"
						/>
					</svg>
				</a>
				</nav>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 820px;
	}
	.quiz-progress {
		margin-bottom: 1.75rem;
	}
	.intro {
		margin-bottom: 1.1rem;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	kbd {
		display: inline-block;
		padding: 0.05em 0.5em;
		font: inherit;
		font-size: 0.85em;
		border: 1px solid rgb(var(--gray-light));
		border-bottom-width: 2px;
		border-radius: 5px;
		background: #fff;
	}
	.quiz-progress {
		display: flex;
		align-items: center;
		gap: 0.75em;
	}
	.quiz-progress-track {
		flex: 1;
		height: 8px;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		overflow: hidden;
	}
	.quiz-progress-fill {
		height: 100%;
		min-width: 6px;
		border-radius: inherit;
		background: linear-gradient(90deg, var(--accent), var(--accent-dark));
		transition: width 0.4s ease;
	}
	.quiz-progress-label {
		font-size: 0.78em;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	.pager {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		margin-top: 1.75rem;
		font-size: 0.85em;
	}
	.step {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		min-height: 2.4em;
		padding: 0.45em 1.1em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		white-space: nowrap;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease,
			transform 0.15s ease;
	}
	a.step[href]:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
		transform: translateY(-1px);
	}
	a.step[href]:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.step.disabled {
		color: rgb(var(--gray));
		opacity: 0.45;
		cursor: default;
	}
	.jump {
		display: flex;
		align-items: center;
		gap: 0.5em;
		color: rgb(var(--gray-dark));
	}
	.counter {
		white-space: nowrap;
	}
	.jump input {
		width: 5em;
		padding: 0.3em 0.5em;
		margin: 0 0.3em;
		font: inherit;
		font-size: 1em;
		text-align: center;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
	}
	.jump input:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}
	.jump button {
		font: inherit;
		font-size: 1em;
		min-height: 2.2em;
		padding: 0.4em 0.9em;
		color: #fff;
		background: var(--accent);
		border: none;
		border-radius: 999px;
		cursor: pointer;
		transition: background 0.15s ease;
	}
	.jump button:hover {
		background: var(--accent-dark);
	}
	.jump button:focus-visible {
		outline: 2px solid var(--accent-dark);
		outline-offset: 2px;
	}
	@media (max-width: 720px) {
		.pager {
			justify-content: center;
		}
		.step span {
			display: none;
		}
		.step {
			padding: 0.6em 0.9em;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.step,
		.quiz-progress-fill,
		.jump button {
			transition: none;
		}
	}
</style>

<style is:global>
	/* 切题时用同文档 View Transitions 做一个轻量的滑入滑出；方向由 saa-quiz.ts
	   写到 <html data-saa-dir>。不支持的浏览器直接原地更新，属于渐进增强。 */
	@media (prefers-reduced-motion: no-preference) {
		@keyframes saa-slide-out-left {
			to {
				transform: translateX(-4%);
				opacity: 0;
			}
		}
		@keyframes saa-slide-in-right {
			from {
				transform: translateX(4%);
				opacity: 0;
			}
		}
		@keyframes saa-slide-out-right {
			to {
				transform: translateX(4%);
				opacity: 0;
			}
		}
		@keyframes saa-slide-in-left {
			from {
				transform: translateX(-4%);
				opacity: 0;
			}
		}

		/* 只让题目卡片参与动画；根节点（导航、标题、页脚）以及进度条、分页器
		   只更新数值，保持原样不动。 */
		.quiz-card {
			view-transition-name: saa-main;
		}
		html[data-saa-dir]::view-transition-old(root),
		html[data-saa-dir]::view-transition-new(root) {
			animation: none;
			mix-blend-mode: normal;
		}
		html[data-saa-dir='next']::view-transition-old(saa-main) {
			animation: 160ms ease-in both saa-slide-out-left;
		}
		html[data-saa-dir='next']::view-transition-new(saa-main) {
			animation: 220ms ease-out both saa-slide-in-right;
		}
		html[data-saa-dir='prev']::view-transition-old(saa-main) {
			animation: 160ms ease-in both saa-slide-out-right;
		}
		html[data-saa-dir='prev']::view-transition-new(saa-main) {
			animation: 220ms ease-out both saa-slide-in-left;
		}
	}
</style>

<script>
	import '../../../scripts/saa-quiz';
</script>
