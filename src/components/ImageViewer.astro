---
// 文章正文图片的点击放大：点击 `.prose` 里的图片，在全屏浮层里查看。
// 支持：滚轮 / 按钮 / 键盘（+ - 0）缩放，拖动平移，双指捏合，双击在 1x 与 2.5x 之间切换，
// Esc、点空白处或关闭按钮退出。用原生 <dialog>，焦点管理和 Esc 由浏览器负责。
---

<dialog class="image-viewer" data-image-viewer aria-label="图片查看器">
	<div class="stage" data-stage>
		<img data-viewer-img alt="" draggable="false" />
	</div>
	<div class="toolbar" role="toolbar" aria-label="图片缩放">
		<button type="button" data-action="out" aria-label="缩小">−</button>
		<span class="level" data-level aria-live="polite">100%</span>
		<button type="button" data-action="in" aria-label="放大">+</button>
		<button type="button" data-action="reset" aria-label="还原">还原</button>
		<button type="button" data-action="close" aria-label="关闭">✕</button>
	</div>
</dialog>

<style>
	.image-viewer {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: none;
		background: rgba(15, 18, 25, 0.88);
		color: #fff;
		overflow: hidden;
	}
	.image-viewer:not([open]) {
		display: none;
	}
	.image-viewer::backdrop {
		background: transparent;
	}
	.stage {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		overflow: hidden;
		touch-action: none;
		cursor: zoom-out;
	}
	.stage img {
		max-width: 92vw;
		max-height: 88vh;
		object-fit: contain;
		user-select: none;
		-webkit-user-drag: none;
		cursor: grab;
		border-radius: 4px;
		background: #fff;
		transform-origin: 50% 50%;
	}
	.stage.dragging img {
		cursor: grabbing;
	}
	.toolbar {
		position: absolute;
		top: 1rem;
		right: 1rem;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.25rem;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.55);
		backdrop-filter: blur(6px);
	}
	.toolbar button {
		min-width: 2.2rem;
		height: 2.2rem;
		padding: 0 0.6rem;
		font: inherit;
		font-size: 0.95rem;
		color: #fff;
		background: transparent;
		border: none;
		border-radius: 999px;
		cursor: pointer;
	}
	.toolbar button:hover {
		background: rgba(255, 255, 255, 0.18);
	}
	.toolbar button:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 1px;
	}
	.level {
		min-width: 3.2rem;
		text-align: center;
		font-size: 0.85rem;
		font-variant-numeric: tabular-nums;
	}
</style>

<style is:global>
	.prose img {
		cursor: zoom-in;
	}
	.prose img:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	html:has(dialog.image-viewer[open]) {
		overflow: hidden;
	}
</style>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-image-viewer]');
	const stage = dialog?.querySelector<HTMLElement>('[data-stage]');
	const viewerImg = dialog?.querySelector<HTMLImageElement>('[data-viewer-img]');
	const level = dialog?.querySelector<HTMLElement>('[data-level]');

	if (dialog && stage && viewerImg && level) {
		const MIN = 0.5;
		const MAX = 8;
		const STEP = 1.25;
		let scale = 1;
		let tx = 0;
		let ty = 0;

		const clamp = (value: number) => Math.min(MAX, Math.max(MIN, value));
		const apply = () => {
			viewerImg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
			level.textContent = `${Math.round(scale * 100)}%`;
		};
		const reset = () => {
			scale = 1;
			tx = 0;
			ty = 0;
			apply();
		};
		// 以舞台中心为原点，保持 (cx, cy) 指向的那一点在缩放前后不动。
		const zoomTo = (next: number, cx = 0, cy = 0) => {
			next = clamp(next);
			const k = next / scale;
			tx = cx - (cx - tx) * k;
			ty = cy - (cy - ty) * k;
			scale = next;
			if (scale <= 1) {
				tx = 0;
				ty = 0;
			}
			apply();
		};
		const zoomAtPoint = (next: number, clientX: number, clientY: number) => {
			const rect = stage.getBoundingClientRect();
			zoomTo(next, clientX - (rect.left + rect.width / 2), clientY - (rect.top + rect.height / 2));
		};

		const open = (source: HTMLImageElement) => {
			viewerImg.src = source.currentSrc || source.src;
			viewerImg.alt = source.alt;
			reset();
			dialog.showModal();
		};
		const close = () => dialog.close();

		// 正文里的图片：点击或键盘回车/空格打开。
		const prose = (target: EventTarget | null) =>
			target instanceof Element ? target.closest<HTMLImageElement>('.prose img') : null;
		document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
			img.tabIndex = 0;
			img.setAttribute('role', 'button');
			img.setAttribute('aria-label', `查看大图：${img.alt || '图片'}`);
		});
		document.addEventListener('click', (event) => {
			const img = prose(event.target);
			if (!img) return;
			event.preventDefault(); // 图片被链接包住时不要跳转
			open(img);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			const img = prose(event.target);
			if (!img) return;
			event.preventDefault();
			open(img);
		});

		// 工具栏按钮
		dialog.querySelector('.toolbar')?.addEventListener('click', (event) => {
			const action = (event.target as Element).closest<HTMLElement>('[data-action]')?.dataset.action;
			if (action === 'in') zoomTo(scale * STEP);
			else if (action === 'out') zoomTo(scale / STEP);
			else if (action === 'reset') reset();
			else if (action === 'close') close();
		});

		// 键盘：+ - 0
		dialog.addEventListener('keydown', (event) => {
			if (event.key === '+' || event.key === '=') zoomTo(scale * STEP);
			else if (event.key === '-' || event.key === '_') zoomTo(scale / STEP);
			else if (event.key === '0') reset();
		});

		// 滚轮缩放（以光标为中心）
		stage.addEventListener(
			'wheel',
			(event) => {
				event.preventDefault();
				zoomAtPoint(scale * Math.exp(-event.deltaY * 0.0015), event.clientX, event.clientY);
			},
			{ passive: false },
		);

		// 指针：单指拖动平移，双指捏合缩放
		const pointers = new Map<number, { x: number; y: number }>();
		let pinch: { dist: number; scale: number } | null = null;
		let moved = false;
		const distance = () => {
			const [a, b] = [...pointers.values()];
			return Math.hypot(a.x - b.x, a.y - b.y);
		};

		stage.addEventListener('pointerdown', (event) => {
			stage.setPointerCapture(event.pointerId);
			pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
			moved = false;
			if (pointers.size === 2) pinch = { dist: distance(), scale };
			stage.classList.toggle('dragging', event.target === viewerImg);
		});
		stage.addEventListener('pointermove', (event) => {
			const prev = pointers.get(event.pointerId);
			if (!prev) return;
			const next = { x: event.clientX, y: event.clientY };
			pointers.set(event.pointerId, next);
			if (pointers.size === 2 && pinch) {
				const [a, b] = [...pointers.values()];
				zoomAtPoint(pinch.scale * (distance() / pinch.dist), (a.x + b.x) / 2, (a.y + b.y) / 2);
				moved = true;
			} else if (pointers.size === 1 && scale > 1) {
				tx += next.x - prev.x;
				ty += next.y - prev.y;
				if (next.x !== prev.x || next.y !== prev.y) moved = true;
				apply();
			}
		});
		const endPointer = (event: PointerEvent) => {
			pointers.delete(event.pointerId);
			if (pointers.size < 2) pinch = null;
			stage.classList.remove('dragging');
		};
		stage.addEventListener('pointerup', endPointer);
		stage.addEventListener('pointercancel', endPointer);

		// 点空白处关闭（拖动结束时不算）；双击图片在 1x 与 2.5x 之间切换。
		stage.addEventListener('click', (event) => {
			if (event.target === stage && !moved) close();
		});
		viewerImg.addEventListener('dblclick', (event) => {
			zoomAtPoint(scale > 1 ? 1 : 2.5, event.clientX, event.clientY);
		});
	}
</script>
