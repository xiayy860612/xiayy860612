---
import type { CollectionEntry } from 'astro:content';
import { renderBack, renderFront } from '../lib/saa';
import FlipCard from './FlipCard.astro';

interface Props {
	question: CollectionEntry<'awsSaa'>;
	/** 固定卡片高度；不传则由内容撑开，见 FlipCard */
	height?: string;
	minHeight?: string;
}

const { question, height, minHeight } = Astro.props;
---

<!-- 正反面的 HTML 由 lib/saa.ts 生成：首屏在构建期渲染，切题时浏览器里用同一份函数
     重新生成，所以样式是 is:global（带 saa- 前缀），否则 scoped 样式作用不到 JS 写入的节点。 -->
<FlipCard height={height} minHeight={minHeight}>
	<Fragment slot="front"><Fragment set:html={renderFront(question.data)} /></Fragment>
	<Fragment slot="back"><Fragment set:html={renderBack(question.data)} /></Fragment>
</FlipCard>

<style is:global>
	.saa-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin-bottom: 1em;
	}
	.saa-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		padding: 0.2em 0.8em;
		font-size: 0.78em;
		font-weight: 600;
		line-height: 1.6;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
	}
	.saa-badge-index {
		background: rgba(var(--gray), 15%);
		font-variant-numeric: tabular-nums;
	}
	.saa-badge-type {
		background: rgba(35, 55, 255, 10%);
		color: var(--accent-dark);
	}
	.saa-badge-answer {
		background: linear-gradient(135deg, var(--accent), var(--accent-dark));
		color: #fff;
	}
	.saa-stem {
		margin: 0 0 1.1em;
		font-weight: 700;
		font-size: 1.05em;
		line-height: 1.5;
		color: rgb(var(--black));
	}
	.saa-options {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.saa-options li {
		margin-bottom: 0.6em;
		padding: 0.15em 0;
	}
	.saa-options-correct li {
		padding: 0.55em 0.9em;
		border-left: 4px solid var(--accent);
		background: rgba(var(--gray-light), 60%);
		border-radius: 0 8px 8px 0;
	}
	.saa-explain {
		margin-top: 1.3em;
		padding-top: 1em;
		border-top: 1px dashed rgb(var(--gray-light));
	}
	.saa-explain h3 {
		margin: 0 0 0.4em;
		font-size: 0.95em;
		color: rgb(var(--gray-dark));
	}
	.saa-explain p {
		margin: 0;
		/* 解析里带 \n，保留换行才不会糊成一大坨。 */
		white-space: pre-line;
	}
</style>
